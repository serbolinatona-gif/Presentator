# ==== Backend (обязательно) ====

# "Authorization key" из личного кабинета GigaChat API: https://developers.sber.ru/studio
# (Client Secret в формате Base64, выдаётся сразу при создании проекта GigaChat API)
GIGACHAT_AUTH_KEY=your_gigachat_authorization_key_here

# Область доступа: GIGACHAT_API_PERS — для физлиц (бесплатный тариф),
# GIGACHAT_API_CORP — для юрлиц. Обычно нужен именно PERS.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модель GigaChat (GigaChat — базовая бесплатная, есть также GigaChat-Pro/Max по подписке)
GIGACHAT_MODEL=GigaChat

# GigaChat использует российский сертификат (Минцифры), которого обычно нет в системном
# доверенном хранилище — поэтому по умолчанию проверка TLS отключена (false).
# Поставь true, если установил на сервере "Минцифры Root CA" и хочешь проверять честно.
GIGACHAT_VERIFY_SSL=false

# Разрешённые origins для CORS (через запятую). "*" — для локальной разработки.
ALLOWED_ORIGINS=*

# ==== Изображения ====
# Ключ не нужен — используется Picsum Photos (picsum.photos), бесплатный сервис без регистрации.

# ==== Frontend (опционально) ====

# Базовый URL API, если бэкенд задеплоен отдельно от фронтенда.
# Для локальной разработки не нужен — используется прокси из vite.config.js.
VITE_API_BASE=/api
VITE_BACKEND_URL=http://localhost:8000
